{
  "name": "nusantara-admin",
  "version": "2.75.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run env && ng serve --port=4201",
    "start:local-proxy": "npm run env && ng serve --port=4201 --configuration=en",
    "start:local-proxy:id": "npm run env && ng serve --port=4201 --configuration=id",
    "start:prod": "npm run env && ng serve --port=4201 --configuration production",
    "build": "npm run env && ng build",
    "build:prod": "npm run env && ng build --configuration production",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "env": "ngx-scripts env APM_URL APM_ACTIVE APM_NAME APM_ENVIRONMENT YOUTUBE_KEY GA_MEASUREMENT_ID",
    "extract:i18n": "ng extract-i18n --output-path src/locale"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^13.3.11",
    "@angular/cdk": "^13.3.9",
    "@angular/common": "^13.3.11",
