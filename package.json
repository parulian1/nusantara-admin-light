    "@angular/localize": "^13.3.11",
    "@types/file-saver": "^2.0.5",
    "@types/jasmine": "^3.10.6",
    "@types/jasminewd2": "^2.0.10",
    "@types/node": "^14.18.29",
    "@typescript-eslint/eslint-plugin": "5.27.1",
