{
  "name": "nusantara-admin",
  "version": "2.63.1",
  "scripts": {
    "ng": "ng",
    "start": "npm run env && ng serve --port=4201",
    "start:local-proxy": "npm run env && ng serve --port=4201 --configuration=en",
    "start:local-proxy:id": "npm run env && ng serve --port=4201 --configuration=id",
    "start:prod": "npm run env && ng serve --port=4201 --prod",
