    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "env": "ngx-scripts env APM_URL APM_ACTIVE APM_NAME APM_ENVIRONMENT YOUTUBE_KEY",
    "extract:i18n": "ng extract-i18n --output-path src/locale"
  },
  "private": true,
